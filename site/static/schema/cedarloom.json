{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cedarloom.github.io/cedarloom/schema/cedarloom.json",
  "title": "CedarLoom repository settings (cedarloom.json at the repository root)",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^//": {} },
  "$defs": {
    "pair": { "title": "{ model, effort }", "type": "object", "additionalProperties": false, "patternProperties": { "^//": {} }, "required": ["model", "effort"], "properties": { "model": { "enum": ["haiku", "sonnet", "opus", "fable"] }, "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] } } },
    "role": { "title": "a role name", "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "value": { "anyOf": [{ "$ref": "#/$defs/role" }, { "$ref": "#/$defs/pair" }] },
    "build": { "anyOf": [{ "$ref": "#/$defs/role" }, { "title": "{ model: opus, effort }", "type": "object", "additionalProperties": false, "patternProperties": { "^//": {} }, "required": ["model", "effort"], "properties": { "model": { "enum": ["opus"] }, "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] } } }] },
    "row": { "type": "object", "additionalProperties": false, "patternProperties": { "^//": {} }, "properties": { "coordinate": { "$ref": "#/$defs/value" }, "plan": { "$ref": "#/$defs/value" }, "review": { "$ref": "#/$defs/value" }, "recheck": { "$ref": "#/$defs/value" }, "verify": { "$ref": "#/$defs/value" }, "fresh-read": { "$ref": "#/$defs/value" }, "audit": { "$ref": "#/$defs/value" }, "research": { "$ref": "#/$defs/value" }, "implement": { "$ref": "#/$defs/build" }, "fix": { "$ref": "#/$defs/build" }, "test": { "$ref": "#/$defs/value" }, "docs": { "$ref": "#/$defs/value" }, "triage": { "$ref": "#/$defs/value" }, "digest": { "$ref": "#/$defs/value" }, "merge": { "$ref": "#/$defs/value" }, "gather": { "$ref": "#/$defs/value" }, "lookup": { "$ref": "#/$defs/value" } } }
  },
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "enum": [3] },
    "startLabel": { "type": "string", "minLength": 1 },
    "trustedAuthors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "workersPerProject": { "type": "integer", "minimum": 1, "maximum": 32 },
    "hostWorkerLimit": { "type": "integer", "minimum": 1, "maximum": 64 },
    "stallMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "issuesPerWorker": { "type": "integer", "minimum": 1, "maximum": 16 },
    "keepRunning": { "type": "boolean" },
    "mode": { "enum": ["supervised", "automatic"] },
    "minPlugin": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "riskyPaths": { "type": "array", "items": { "type": "string", "pattern": "^(?!\\s)(?!\\.{1,2}(?:/|$))[^/\\\\*\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]+(?<!\\s)(?:/(?!\\s)(?!\\.{1,2}(?:/|$))[^/\\\\*\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]+(?<!\\s))*/?$" } },
    "issues": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^//": {} },
      "properties": {
        "labels": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^//": {} },
      "properties": {
        "roles": { "type": "object", "additionalProperties": false, "patternProperties": { "^//": {}, "^[a-z][a-z0-9-]*$": { "$ref": "#/$defs/pair" } } },
        "tasks": { "$ref": "#/$defs/row" },
        "depth": { "type": "object", "additionalProperties": false, "patternProperties": { "^//": {} }, "properties": { "quick": { "$ref": "#/$defs/row" }, "deep": { "$ref": "#/$defs/row" } } },
        "risk": { "type": "object", "additionalProperties": false, "patternProperties": { "^//": {} }, "properties": { "high": { "$ref": "#/$defs/row" }, "critical": { "$ref": "#/$defs/row" } } }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^//": {} },
      "properties": {
        "depth": { "enum": ["low", "medium", "high", "xhigh"] },
        "sensitiveDepth": { "enum": ["low", "medium", "high", "xhigh"] },
        "sensitivePaths": { "type": "array", "items": { "type": "string", "pattern": "^(?!\\s)(?!\\.{1,2}(?:/|$))[^/\\\\*\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]+(?<!\\s)(?:/(?!\\s)(?!\\.{1,2}(?:/|$))[^/\\\\*\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]+(?<!\\s))*/?$" } }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^//": {} },
      "properties": {
        "allowed": { "type": "boolean" },
        "requiredChecks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "mode": { "enum": ["strict", "disjoint"] },
        "autoMergeMax": { "enum": ["low", "medium"] },
        "additivePaths": { "type": "array", "items": { "type": "string", "pattern": "^(?!\\s)(?!\\.{1,2}(?:/|$))[^/\\\\*\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]+(?<!\\s)(?:/(?!\\s)(?!\\.{1,2}(?:/|$))[^/\\\\*\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]+(?<!\\s))*/?$" } },
        "ownerOnlyPaths": { "type": "array", "items": { "type": "string", "pattern": "^(?!\\s)(?!\\.{1,2}(?:/|$))[^/\\\\*\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]+(?<!\\s)(?:/(?!\\s)(?!\\.{1,2}(?:/|$))[^/\\\\*\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]+(?<!\\s))*/?$" } }
      }
    },
    "closeIssue": { "type": "boolean" },
    "deleteMergedBranch": { "type": "boolean" }
  }
}
