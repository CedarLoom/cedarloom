{
  "$description": "The CedarLoom palette and font in the Design Tokens Format (DTCG 2025.10): the shared base palette plus the CedarLoom accent, per color scheme. brand/build-tokens.mjs writes brand/tokens.css from this file.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": [
        "Albert Sans",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "weight": {
      "$type": "fontWeight",
      "display": {"$value": 300},
      "body": {"$value": 400},
      "strong": {"$value": 600}
    }
  },
  "color": {
    "$type": "color",
    "light": {
      "surface": {"$value": {"colorSpace": "oklch", "components": [0.97, 0.003, 95]}},
      "ink": {"$value": {"colorSpace": "oklch", "components": [0.21, 0.004, 250]}},
      "ink-2": {
        "$description": "Muted text.",
        "$value": {"colorSpace": "oklch", "components": [0.45, 0.006, 250]}
      },
      "danger": {"$value": {"colorSpace": "oklch", "components": [0.5, 0.17, 32]}},
      "focus": {"$value": "{color.light.ink}"},
      "accent": {
        "$description": "The CedarLoom accent; also passes as text on the surface.",
        "$value": {"colorSpace": "srgb", "components": [0.1804, 0.3686, 0.3059], "hex": "#2e5e4e"}
      },
      "accent-node": {
        "$description": "The rust node of the CedarLoom mark.",
        "$value": {"colorSpace": "srgb", "components": [0.6431, 0.2784, 0.1804], "hex": "#a4472e"}
      }
    },
    "dark": {
      "surface": {"$value": {"colorSpace": "oklch", "components": [0.19, 0.004, 250]}},
      "ink": {"$value": {"colorSpace": "oklch", "components": [0.96, 0.003, 95]}},
      "ink-2": {
        "$description": "Muted text.",
        "$value": {"colorSpace": "oklch", "components": [0.78, 0.005, 250]}
      },
      "danger": {"$value": {"colorSpace": "oklch", "components": [0.78, 0.13, 35]}},
      "focus": {"$value": "{color.dark.accent}"},
      "accent": {
        "$description": "The CedarLoom accent; also passes as text on the surface.",
        "$value": {"colorSpace": "srgb", "components": [0.498, 0.749, 0.651], "hex": "#7fbfa6"}
      },
      "accent-node": {
        "$description": "The rust node of the CedarLoom mark.",
        "$value": {"colorSpace": "srgb", "components": [0.8784, 0.5216, 0.4], "hex": "#e08566"}
      }
    }
  }
}
